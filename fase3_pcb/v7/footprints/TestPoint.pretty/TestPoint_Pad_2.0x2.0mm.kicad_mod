(module TestPoint_Pad_2.0x2.0mm (layer F.Cu) (tedit 5D68B0F0) (tstamp 00000000)
  (descr "EXTRACAO do board v7_drone.kicad_pcb, modulo de origem TP_UART_RX. Pads, fp_line, fp_arc, fp_circle e fp_text copiados do board sem alteracao de geometria. NAO reproduzidos: lib nickname (o formato 20171130 do KiCad 5.1 nao o grava), modelos 3D (o board nao tem link 3dmodel) e grupo path. Ver README.md desta pasta.")
  (tags "extracao-do-board TestPoint")
  (attr smd)
  (fp_text reference "TP_UART_RX" (at 0 0) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "TestPoint" (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "${REFERENCE}" (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_line (start -1.2 -1.2) (end 1.2 -1.2) (layer F.SilkS) (width 0.12))
  (fp_line (start 1.2 -1.2) (end 1.2 1.2) (layer F.SilkS) (width 0.12))
  (fp_line (start 1.2 1.2) (end -1.2 1.2) (layer F.SilkS) (width 0.12))
  (fp_line (start -1.2 1.2) (end -1.2 -1.2) (layer F.SilkS) (width 0.12))
  (fp_line (start -1.5 -1.5) (end 1.5 -1.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.5 -1.5) (end -1.5 1.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.5 1.5) (end 1.5 -1.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.5 1.5) (end -1.5 1.5) (layer F.CrtYd) (width 0.05))
  (pad 1 smd rect (at 0 0) (size 2 2) (layers F.Cu F.Mask)
  )
)
