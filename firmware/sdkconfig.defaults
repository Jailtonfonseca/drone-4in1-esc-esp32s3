# ===========================================================================
# firmware/sdkconfig.defaults — configuracao padrao do sdkconfig
#
# ESQUELETO corrigido pela auditoria de 2026-10-04 (ver
# AUDITORIA_ERROS_2026-10-04.md, secao F, achado F9); AINDA NAO COMPILADO —
# nenhuma ferramenta consumiu este arquivo nesta maquina porque o ESP-IDF nao
# esta instalado. Uma chave escrita errado aqui so aparece como erro no
# primeiro `idf.py build`. Ver ../fase4_entrega/FIRMWARE_BUILD.md.
#
# As chaves vem da ESP-IDF v5. Os valores sao os que a §5 e os modulos exigem:
#   - clock de 240 MHz, o clock nominal do ESP32-S3, com PMU ligada para o
#     RF-12 calcular FLOP/s contra 160 MHz;
#   - 20 kHz de PWM e SPI a 0,60 MHz sao configurados em codigo (m2/m3/m4), nao
#     aqui, porque sao parametros de modulo e nao de build;
#   - brownout detector ligado, por causa do RF-13: um brownout em voo precisa
#     ficar registrado como tal e nao como watchdog, e o registro do motivo do
#     reset e tarefa do M11, que nao existe ainda.
#
# RF-12 mede a conta de FLOP do PID contra 160 MHz; o 240 MHz aqui e o clock
# real do chip, entao o calculo de folga do RF-12 fica ainda mais folgado.
# ========================================================================

CONFIG_IDF_TARGET="esp32s3"

# --- Tick do FreeRTOS (achado F9 da auditoria) -------------------------------
# CONFIG_FREERTOS_HZ=1000: sem esta linha o default e 100 Hz, e
# pdMS_TO_TICKS(1) trunca para 0 tick — vTaskDelay(0) e so um yield, o laco
# de leitura do app_main faminta a idle da CPU0 e o task watchdog dispara a
# cada 5 s. Com 1000 Hz, 1 ms = 1 tick de verdade.
CONFIG_FREERTOS_HZ=1000

# --- Clock ------------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PM_ENABLE=y

# --- Flash e particionamento -------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- Particao padrao de aplicacao -------------------------------------------
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- Seguranca e brownout ---------------------------------------------------
# Brownout detection para o RF-13: o motivo do reset precisa ser legivel.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- Pilha do sistema --------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# --- UART0 para log de boot -------------------------------------------------
# O M0 da §5 exige ler o log de boot pela UART0. USB nativo (USB-SERIAL-JTAG)
# fica fora: o layout traz USB_DM/USB_DP nos pads 13 e 14 para boot, e o
# primeiro bring-up tem que ser pela UART0 para nao depender dessa via.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
